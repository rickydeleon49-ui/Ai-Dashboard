{
  "name": "ai-dashboard",
  "version": "0.5.0",
  "private": true,
  "description": "Personal AI Dashboard / Command Center — web and desktop",
  "author": "rickydeleon49-ui",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/dashboard.db',{force:true})\" && npm run db:migrate && npm run db:seed",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:migrate:pg": "tsx src/db/migrate.pg.ts",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:build": "node desktop/build.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --publish never",
    "desktop:package:all": "npm run desktop:build && electron-builder -mwl --publish never",
    "desktop:icon": "node desktop/make-icon.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && tsx --conditions=react-server --test --test-concurrency=1 tests/e2e/routes.test.ts tests/e2e/flows.test.ts tests/e2e/fresh-start-readiness.test.ts",
    "test:desktop": "tsx --conditions=react-server --test --test-concurrency=1 tests/e2e/desktop.test.ts",
    "test:unit:pg": "tsx --conditions=react-server --test tests/unit-pg/*.test.ts",
    "test:unit:pg:auth": "node tests/helpers/run-pg-auth.mjs",
    "test:e2e:accounts": "tsx --test tests/e2e/accounts-mode.test.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.544.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.rickydeleon.commandcenter",
    "productName": "Command Center",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/**/*",
      ".next/standalone/**/*",
      "drizzle/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map",
      "!**/{test,tests,__tests__,example,examples}/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/resources/icon.ico"
    },
    "linux": {
      "category": "Development",
      "icon": "desktop/resources/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "Personal project command center"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Command Center",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/resources/icon.ico",
      "uninstallerIcon": "desktop/resources/icon.ico"
    }
  },
  "overrides": {
    "nodemailer": "^10.0.2"
  }
}
