# ---------------------------------------------------------------------------
# Command Center — Self-Hosted Mode Configuration
# Copy this file to .env.selfhosted in your repository root.
# ---------------------------------------------------------------------------

# Opt into self-hosted mode (REQUIRED: must be exactly "self-hosted")
AGENT_HOST_MODE=self-hosted

# Bind address for the Next.js server (REQUIRED: defaults to 127.0.0.1)
# Binds loopback so access is gated behind Tailscale or a reverse proxy.
# Wildcard addresses (e.g. all interfaces) are strictly forbidden.
HOSTNAME=127.0.0.1

# Allow binding to a private LAN or Tailscale interface IP (optional, default: 0)
# Set to 1 only when HOSTNAME is set to a private network or Tailscale address.
# AGENT_HOST_ALLOW_LAN=1

# Port to listen on (optional, default: 3000)
PORT=3000

# Path to the persistent SQLite database file (REQUIRED)
# Example: ./data/dashboard.db or /path/to/data/dashboard.db
DATABASE_PATH=./data/dashboard.db

# Optional path for the operator credentials file (default: data/operator.json)
# The operator password is set on the machine with `npm run operator:password`.
# OPERATOR_FILE=./data/operator.json

# ---------------------------------------------------------------------------
# SAFETY INVARIANTS: FORBIDDEN VARIABLES
# ---------------------------------------------------------------------------
# Self-hosted mode is a separate, private security boundary.
# The server REFUSES to start if any of the following variables are set:
#
#   - AUTH_MODE=accounts or DATABASE_URL (hosted multi-user accounts mode)
#   - DASHBOARD_PASSWORD (hosted single-password mode)
#   - DASHBOARD_LOCAL=1 or DESKTOP_INTERNAL_SECRET (Electron desktop mode)
#   - Any RAILWAY_* variable (public cloud deployment)
