# ---------------------------------------------------------------------------
# AI Dashboard — environment configuration
# Copy to .env.local for local development. All values are optional in Phase 1.
# ---------------------------------------------------------------------------

# Where the SQLite database file lives.
# Local default: ./data/dashboard.db
# Railway: point this at a mounted volume, e.g. /data/dashboard.db
DATABASE_PATH=./data/dashboard.db

# Where uploaded project files are written (Phase 3).
# Railway: use the same volume, e.g. /data/uploads
UPLOADS_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Required for any deployment reachable over a network. Without it, a production
# server refuses to serve the dashboard rather than exposing it — the browser
# will prompt for this password (any username).
#
# Not needed for the desktop app, which runs on 127.0.0.1, or for `npm run dev`.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------
# Phase 1/2: a Personal Access Token is the fastest path to REAL repository data.
# Create one at https://github.com/settings/tokens with the `repo` scope
# (or `public_repo` if you only want public repositories).
# When this is unset, the dashboard runs on a clearly-labelled demo provider.
GITHUB_TOKEN=

# Enables "Connect with GitHub" in Settings, which authorises through GitHub's
# device flow — no token to create, no permissions to choose.
#
# Optional: the Client ID can also be pasted into Settings, which is the easier
# route for the desktop app. A value set here is used only when none is saved
# in the application.
#
# Create an OAuth App at https://github.com/settings/developers:
#   * Application name and homepage URL can be anything.
#   * Authorization callback URL is required by the form but unused; put
#     http://localhost
#   * Tick "Enable Device Flow" — without it, GitHub rejects the request.
# Copy the Client ID below. No client secret is needed: the device flow does not
# use one, which is why it is safe to ship in a desktop application.
GITHUB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Hosted multi-user mode (accounts, workspaces) — under construction
# ---------------------------------------------------------------------------
# Everything above this line is unaffected by everything below it: desktop and
# today's single-shared-password hosted mode never read DATABASE_URL or
# AUTH_MODE, and continue to work exactly as before whether or not these are set.
#
# A Postgres connection string. Setting this only switches on the Postgres
# storage path (used by `npm run db:generate:pg` / `db:migrate:pg` and by
# hosted multi-user mode once it exists) — it does not, by itself, change who
# can access the dashboard. That is controlled separately by AUTH_MODE below,
# so setting DATABASE_URL for an unrelated reason (e.g. "I just want Postgres
# storage") can never accidentally turn on a different access-control model.
# Local example: postgres://ai_dashboard:ai_dashboard_dev@localhost:5432/ai_dashboard
DATABASE_URL=

# Set to `accounts` to require signed-in per-user access (GitHub OAuth or
# email sign-in) instead of the single shared DASHBOARD_PASSWORD above.
# Requires DATABASE_URL to also be set — a deployment with AUTH_MODE=accounts
# but no DATABASE_URL refuses to serve anything, the same fail-safe posture
# DASHBOARD_PASSWORD already has, rather than silently falling back to the
# shared-password model.
AUTH_MODE=

# Required by Auth.js once AUTH_MODE=accounts is actually enforced (a future
# step) — signs CSRF tokens and other internal values regardless of session
# strategy. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials for sign-in (distinct from GITHUB_CLIENT_ID
# above, which is for the dashboard's own GitHub *integration*, not user
# login). Auth.js reads these by convention — no other wiring needed.
# Create an OAuth App at https://github.com/settings/developers with an
# Authorization callback URL of <your-url>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# SMTP connection string for magic-link sign-in emails, e.g.
# smtp://user:pass@smtp.example.com:587. Without it — the default for local
# development and every automated test — the magic link is logged to the
# server console instead of emailed, so the flow is still fully usable
# without real mail credentials.
EMAIL_SERVER=
EMAIL_FROM=
